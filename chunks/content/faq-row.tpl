<div class="faq-item accordion-item js-accordion" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
    <div class="faq-item__title accordion-title js-accordion-btn" itemprop="name">{$title}</div>
    <div class="faq-item__content accordion-content" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
        <div itemprop="text">{$content}</div>
    </div>
</div>